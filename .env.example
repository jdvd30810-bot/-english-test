# ==============================================================
# Environment Configuration Template (.env.example)
# Copy this file to .env and adjust variables as needed.
# NOTE: .env is ignored by Git to prevent leaking local secrets.
# ==============================================================

# Local Development Server Port (e.g. npx serve / live-server)
PORT=3000

# OCR Engine CDN (Tesseract.js)
# Can be replaced with your self-hosted mirror or custom CDN endpoint
OCR_CDN_URL=https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js

# Learning Engine Settings
AUTO_ADVANCE_DELAY_MS=1200
STORAGE_KEY=vocab_app_data_v1
CUSTOM_KEY=vocab_app_custom_v1

# Optional: Third-party Dictionary / AI Translation API (for future expansion)
# DICTIONARY_API_KEY=your_dictionary_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
